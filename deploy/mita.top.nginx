# Rate/conn limits (included in http {} via sites-enabled)
limit_req_zone $binary_remote_addr zone=mita_general:10m rate=30r/s;
limit_req_zone $binary_remote_addr zone=mita_api:10m rate=5r/s;
limit_conn_zone $binary_remote_addr zone=mita_conn:10m;

# HTTP -> HTTPS (always apex)
server {
    listen 80;
    server_name mita.top www.mita.top;
    return 301 https://mita.top$request_uri;
}

# www -> apex (HTTPS)
server {
    listen 443 ssl;
    server_name www.mita.top;

    ssl_certificate /etc/letsencrypt/live/mita.top/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/mita.top/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    return 301 https://mita.top$request_uri;
}

# Main site
server {
    listen 443 ssl;
    server_name mita.top;

    ssl_certificate /etc/letsencrypt/live/mita.top/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/mita.top/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    ssl_session_cache shared:SSL:20m;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    client_header_timeout 10s;
    client_body_timeout 10s;
    keepalive_timeout 15s;
    send_timeout 15s;
    reset_timedout_connection on;

    # This site does not use Next.js Server Actions; bot POSTs with this
    # header can tie up the app and fill PM2 logs.
    if ($http_next_action != "") {
        return 403;
    }

    location = /api/submit-lead {
        limit_req zone=mita_api burst=10 nodelay;
        limit_conn mita_conn 10;

        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
    }

    location / {
        limit_req zone=mita_general burst=60 nodelay;
        limit_conn mita_conn 50;

        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }
}
